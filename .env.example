# ==========================================
# ReviewLens Environment Configuration
# ==========================================

# LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=groq

# API Keys (set the key for your active provider)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Override
# Groq default: openai/gpt-oss-120b (also supports openai/gpt-oss-20b, qwen/qwen3.8-27b)
# Gemini default: gemini-2.5-flash
# LLM_MODEL=openai/gpt-oss-120b

# Batching and Cache Settings
# BATCH_SIZE=5
# CACHE_PATH=cache.db
